# Copy to .env (setup script does this for you) and fill in the keys.
# .env is git-ignored. Never commit real keys.

# ---- Required for the full pipeline ----
DEEPGRAM_API_KEY=
# Hugging Face READ token. Accept the terms first at
# https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# ---- LLM1 (transcript refinement) - default provider: DeepSeek ----
LLM1_PROVIDER=deepseek
LLM1_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MAX_TOKENS=8192

# ---- LLM1 optional fallback (used for the rest of the run if the primary returns 429/503/timeout) ----
# Fallback provider: none | groq | gemini | cerebras
LLM1_FALLBACK_PROVIDER=none
LLM1_FALLBACK_MODEL=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MAX_REQUESTS_PER_RUN=10
OPENROUTER_MAX_RETRY_AFTER_S=60
OPENROUTER_503_RETRIES=2

# ---- LLM1 tuning ----
LLM1_TEMPERATURE=0.0
LLM1_TIMEOUT_S=30
LLM1_MAX_RETRIES=3
LLM1_CHUNK_TURNS=40
LLM1_MIN_CONFIDENCE=0.70

# ---- Diarization tuning ----
DIARIZATION_POSTPROCESS=1
DIARIZATION_CLUSTER_THRESHOLD=
DIARIZATION_MERGE_SIM=0.80
DIARIZATION_SPURIOUS_ABS_S=4.0
DIARIZATION_SPURIOUS_FRAC=0.04
DIARIZATION_SPURIOUS_ABS_NO_EMB_S=2.0
DIARIZATION_ABSORB_MIN_SIM=0.30
# auto | cpu | cuda
DIARIZATION_DEVICE=auto
